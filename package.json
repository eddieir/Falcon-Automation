{
  "name": "falcon-automation",
  "version": "1.0.0",
  "description": "AI-Powered Autonomous Testing Framework",
  "main": "falcon.js",
  "directories": {
    "test": "tests"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node falcon.js",
    "test:unit": "node tests/unit/ReportManagerExitCode.check.js && node tests/unit/DBConfigBehavior.check.js && node tests/unit/DashboardAuth.check.js && node tests/unit/CiWait.check.js && node tests/unit/Verification.check.js && node tests/unit/AgentCatalog.check.js && node tests/unit/SubagentGuard.check.js && node tests/unit/Contract.check.js && node tests/unit/ContractStore.check.js && node tests/unit/ContractStoreConcurrency.check.js && node tests/unit/ContractStoreHardening.check.js && node tests/unit/ContractStoreLockOptions.check.js && node tests/unit/ContractStoreDefaultLocation.check.js && node tests/unit/ContractStoreFingerprint.check.js",
    "test:login": "node tests/ui/LoginTest.js",
    "test:checkout": "node tests/ui/CheckoutTest.js",
    "test:search": "node tests/ui/GoogleSearchTest.js",
    "test:ui": "npm run test:login && npm run test:checkout",
    "test:api": "node tests/api/UserApiTest.js && node tests/api/ProductApiTest.js",
    "test:db": "node tests/db/UserDBTest.js && node tests/db/OrderDBTest.js",
    "test:all": "npm test && npm run test:unit && npm run test:ui && npm run test:api && npm run test:db && npm run test:e2e",
    "test:e2e": "npx playwright test tests/full_automation.test.js",
    "demo:gate": "node scripts/demo/gate-run.js",
    "demo:record-run": "node scripts/demo/record-run.js",
    "demo:build": "node scripts/demo/media/build.js",
    "test:demo":"playwright test -c playwright.demo.config.js",
    "demo:record": "npm run test:demo && node docs/demo/build-ui-test-recording.js",
    "report": "allure awesome allure-results -o allure-report && allure open allure-report",
    "test": "npm run test:regression && npm run test:browser",
    "test:regression": "node --test --test-concurrency=1 tests/regression/*.check.cjs",
    "test:browser": "playwright test -c playwright.regression.config.js",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1 tests/regression/*.check.cjs",
    "healing:benchmark": "node src/core/locator/HealingBenchmark.js",
    "healing:pending": "node scripts/healing/review.js list",
    "healing:approve": "node scripts/healing/review.js approve",
    "healing:reject": "node scripts/healing/review.js reject",
    "flaky:list": "node scripts/flakiness/review.js list",
    "flaky:quarantine": "node scripts/flakiness/review.js quarantine",
    "flaky:unquarantine": "node scripts/flakiness/review.js unquarantine",
    "review:status": "node scripts/review/status.js",
    "review:status:strict": "node scripts/review/status.js --fail-on-stale",
    "history:list": "node scripts/history.js list",
    "history:export": "node scripts/history.js export",
    "history:check": "node scripts/history.js check",
    "dashboard": "node scripts/dashboard.js",
    "fixture:serve": "node scripts/fixture/server.js",
    "bench:parallel": "node scripts/benchmark/parallel.js",
    "production:event": "node scripts/production-cycle/append-event.js",
    "production:checkpoint": "node scripts/production-cycle/checkpoint.js",
    "production:ci-wait": "node scripts/production-cycle/ci-wait.js",
    "production:dashboard": "node scripts/production-cycle/dashboard.js",
    "llm:profile:list": "node scripts/llm/profile.js list",
    "llm:profile:show": "node scripts/llm/profile.js show",
    "llm:profile:set": "node scripts/llm/profile.js set",
    "llm:profile:delete": "node scripts/llm/profile.js delete"
  },
  "keywords": [
    "AI",
    "Testing",
    "Automation",
    "Playwright",
    "Self-Healing"
  ],
  "author": "Peyman Iravani",
  "license": "MIT",
  "dependencies": {
    "allure-playwright": "^3.14.0",
    "axios": "^1.8.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "pixelmatch": "^8.0.0",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "allure": "^3.22.1",
    "socket.io-client": "^4.8.4"
  }
}
