# ── Browser ───────────────────────────────────────────────────────────────
BROWSER=chromium          # chromium | firefox | webkit
HEADLESS=true             # true for CI; false to watch the browser locally

# ── LLM provider — optional, enables Tier 3 AI self-healing ──────────────
#
# Data sent to the provider: a bounded candidate list of tag names, a few
# attributes, and text of up to 20 visible interactive elements (max 8 KiB),
# plus the selector, description, and action. Never the full DOM, cookies,
# storage, or environment variables. The same payload shape applies to every
# provider; only the transport endpoint changes.
#
# Azure uses key-based authentication only (Entra ID / managed identity is
# unsupported). openai-compatible requires the explicit opt-in flag
# FALCON_LLM_ALLOW_CUSTOM_ENDPOINT. Proxies are unsupported.
#
# Leave all blank to disable Tier 3 entirely — Tier 1/2 healing and
# everything else keeps working with no provider configured.

# Provider selection: openai | azure-openai | openai-compatible | disabled | none
# Blank or unset means no provider (same as disabled/none).
FALCON_LLM_PROVIDER=

# API key for the selected provider.
FALCON_LLM_API_KEY=

# Model name passed to the provider (e.g. gpt-4o). Blank = provider default.
FALCON_LLM_MODEL=

# Azure-specific: resource name (the subdomain of .openai.azure.com).
FALCON_LLM_AZURE_RESOURCE=

# Azure-specific: host suffix. Required for azure-openai: openai.azure.com or services.ai.azure.com.
FALCON_LLM_AZURE_HOST_SUFFIX=

# Azure-specific: deployment name. Required for azure-openai (do not also set FALCON_LLM_MODEL).
FALCON_LLM_AZURE_DEPLOYMENT=

# Custom endpoint URL for openai-compatible provider.
FALCON_LLM_ENDPOINT=

# Opt-in flags for non-default endpoint policies. All blank = denied.
FALCON_LLM_ALLOW_CUSTOM_ENDPOINT=
FALCON_LLM_ALLOW_HTTP_LOOPBACK=
FALCON_LLM_ALLOW_PRIVATE_ENDPOINT=

# Request timeout in milliseconds. Blank = 10000.
FALCON_LLM_TIMEOUT_MS=

# Maximum retry attempts per request. Blank = 2.
FALCON_LLM_MAX_ATTEMPTS=

# Per-run LLM call budget (total calls across all scenarios). Blank = 50.
FALCON_LLM_RUN_BUDGET=

# Maximum response body size in bytes. Blank = 65536.
FALCON_LLM_MAX_RESPONSE_BYTES=

# Maximum prompt candidates sent to the provider. Blank = 20.
FALCON_LLM_MAX_PROMPT_CANDIDATES=

# Maximum concurrent LLM requests. Blank = 2.
FALCON_LLM_CONCURRENCY=

# Legacy credential source: used ONLY when FALCON_LLM_PROVIDER=openai and
# FALCON_LLM_API_KEY is empty. On its own, OPENAI_API_KEY no longer enables
# Tier 3 (breaking change vs earlier releases).
OPENAI_API_KEY=

# ── API base URL (optional — defaults to jsonplaceholder) ─────────────────
API_BASE_URL=https://jsonplaceholder.typicode.com

# ── Live dashboard (optional) ──────────────────────────────────────────────
DASHBOARD_PORT=3000        # port for `node falcon.js`'s live dashboard
DASHBOARD_HOST=            # blank = 127.0.0.1 (this machine only). Set a LAN address
                           # or 0.0.0.0 only together with DASHBOARD_TOKEN — the
                           # dashboard refuses to start otherwise.
DASHBOARD_LINGER_MS=60000  # how long the dashboard stays up after a run finishes
# DASHBOARD_URL=http://localhost:3000  # set on a standalone test run (e.g.
                                        # `node tests/ui/LoginTest.js`) to report
                                        # its events into an already-running dashboard

# DASHBOARD_TOKEN=              # optional on the default loopback bind (unset =
                                 # unauthenticated, logs a warning on startup).
                                 # REQUIRED when DASHBOARD_HOST is not loopback —
                                 # it's then required on every API route and the
                                 # socket connection, via an Authorization: Bearer
                                 # or X-Dashboard-Token header or the dashboard cookie.
                                 # ?token= is NOT accepted on API routes. Open
                                 # http://localhost:3000/?token=<value> once; the
                                 # dashboard sets an HttpOnly cookie and redirects.
# DASHBOARD_ALLOWED_ORIGIN=      # optional. Restricts the dashboard's socket.io
                                 # CORS policy; defaults to the dashboard's own
                                 # localhost origin. Only matters for cross-origin
                                 # browser access — same-origin (the bundled UI)
                                 # is unaffected either way.

# ── PostgreSQL — required only for DB tests ───────────────────────────────
# Leave DB_HOST/DB_USER blank to skip tests/db/*.js cleanly (the default —
# every other test runs fine with no DB configured). Fill in real values for
# all five below to enable them. Do not paste in placeholder text like
# "your_db_host" here — DBClient only checks these for truthiness, so a
# non-empty placeholder is treated as "configured" and it'll try to connect
# (and, with DB_SSL=true, load SSL_CA_FILE) rather than skip.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=
DB_SSL=false               # set to true only if your Postgres requires TLS

# ── SSL/mTLS — only needed when DB_SSL=true and using client certificates ──
# SSL_CA_FILE=./certs/ca.pem
# SSL_KEY_FILE=./certs/client.key
# SSL_CERT_FILE=./certs/client.crt
# SSL_REJECT_UNAUTHORIZED=true

# ── Review staleness / rehabilitation windows (optional) ───────────────────
# All three are integers, validated at read time; leave blank to use the
# code default named alongside each one below.
# HEALING_PENDING_STALE_DAYS=    # integer 1-3650. Age (from firstSeen) after
                                  # which an unreviewed pending healing fix
                                  # is flagged stale. Default: 14.
# FLAKY_UNREVIEWED_STALE_DAYS=   # integer 1-3650. Age (from flakySince)
                                  # after which a flaky, non-quarantined
                                  # scenario is flagged as needing review.
                                  # Default: 14.
# REHAB_CANDIDATE_WINDOW=        # integer 1-20. Number of consecutive
                                  # passed results, while quarantined, a
                                  # scenario needs before it's surfaced as a
                                  # rehabilitation candidate. Default: 5.

# ── Locator memory / evidence-based healing (optional) ─────────────────────
# FALCON_APPLICATION_ID=         # Scopes locator identities to a chosen
                                  # application name instead of the page's
                                  # origin (e.g. when the same app is served
                                  # from several hostnames, or you want one
                                  # shared scope across environments). Leave
                                  # blank to scope by origin, which is fine
                                  # for most single-origin setups.
# FALCON_LOCATOR_SALT=           # HMAC salt used to hash identity-bearing
                                  # attribute values before they are stored in
                                  # data/locator_memory.json. Leave blank and
                                  # a salt is generated for you and persisted
                                  # in that file's own header, alongside the
                                  # hashes it protects — this is a real,
                                  # stated weakness, not a solved one: it
                                  # leaves low-entropy values brute-forceable
                                  # offline by anyone who can read that file.
                                  # The hashed values are not irrecoverable.
                                  # Set this to a long random value to keep
                                  # the salt out of the file entirely.

# ── Run history and trend (optional) ──────────────────────────────────────
FALCON_RUN_HISTORY=              # blank = on. "off" (or "0"/"false") stops falcon.js
                                 # recording runs to data/run_history.json and makes
                                 # the history commands report "disabled".
FALCON_TREND_BASELINE_N=         # blank = 10. How many previous complete runs on the
                                 # same branch and repeat count form the baseline (1-500).
FALCON_TREND_MIN_BASELINE=       # blank = 10. How many of those runs must exist
                                 # before any trend flag can be raised (1-500).
