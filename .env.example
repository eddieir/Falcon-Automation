# ── Browser ───────────────────────────────────────────────────────────────
BROWSER=chromium          # chromium | firefox | webkit
HEADLESS=true             # true for CI; false to watch the browser locally

# ── OpenAI — optional, enables Tier 3 AI self-healing ─────────────────────
# Leave blank to skip Tier 3 entirely — every call site guards on this being
# unset (`if (!process.env.OPENAI_API_KEY) return null`), so Tier 1/2 healing
# and everything else keeps working with no key at all.
OPENAI_API_KEY=

# ── API base URL (optional — defaults to jsonplaceholder) ─────────────────
API_BASE_URL=https://jsonplaceholder.typicode.com

# ── Live dashboard (optional) ──────────────────────────────────────────────
DASHBOARD_PORT=3000        # port for `node falcon.js`'s live dashboard
DASHBOARD_LINGER_MS=60000  # how long the dashboard stays up after a run finishes
# DASHBOARD_URL=http://localhost:3000  # set on a standalone test run (e.g.
                                        # `node tests/ui/LoginTest.js`) to report
                                        # its events into an already-running dashboard

# DASHBOARD_TOKEN=              # optional. Unset = unauthenticated (local-only
                                 # default, logs a warning on startup). Set this
                                 # before pointing the dashboard at anything beyond
                                 # your own laptop — it's then required on
                                 # POST /emit, GET /events, and the socket
                                 # connection. Open the dashboard at
                                 # http://localhost:3000/?token=<value> once set.
# DASHBOARD_ALLOWED_ORIGIN=      # optional. Restricts the dashboard's socket.io
                                 # CORS policy; defaults to the dashboard's own
                                 # localhost origin. Only matters for cross-origin
                                 # browser access — same-origin (the bundled UI)
                                 # is unaffected either way.

# ── PostgreSQL — required only for DB tests ───────────────────────────────
# Leave DB_HOST/DB_USER blank to skip tests/db/*.js cleanly (the default —
# every other test runs fine with no DB configured). Fill in real values for
# all five below to enable them. Do not paste in placeholder text like
# "your_db_host" here — DBClient only checks these for truthiness, so a
# non-empty placeholder is treated as "configured" and it'll try to connect
# (and, with DB_SSL=true, load SSL_CA_FILE) rather than skip.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=
DB_SSL=false               # set to true only if your Postgres requires TLS

# ── SSL/mTLS — only needed when DB_SSL=true and using client certificates ──
# SSL_CA_FILE=./certs/ca.pem
# SSL_KEY_FILE=./certs/client.key
# SSL_CERT_FILE=./certs/client.crt
# SSL_REJECT_UNAUTHORIZED=true
