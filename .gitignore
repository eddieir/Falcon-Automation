# Node.js Dependencies
node_modules/

# Environment Variables
.env
.env.*
!.env.example

# Private keys and certificate material
*.key
*.pem
*.p12
*.pfx

# Config Files (User-Specific)
config/testConfig.json

# Reports & Logs
reports/
allure-results/
allure-report/
.allure/
logs/
execution.log

# Persisted LocatorStore entries (runtime state, not source — see README
# Project Structure, which already documented this as gitignored).
data/

# Business-outcome-contract approval store default location (G77B-03,
# issue #125): hash-chained events.jsonl, its .lock / .lock.steal mutex
# files and SafeFs's atomic-write .tmp files, per journeyId, under
# data/outcome-approvals/. Already covered by the broader `data/` rule
# above; kept as its own narrow, anchored entry so this runtime state stays
# ignored even if that broader rule is ever narrowed (see
# docs/roadmap/BUSINESS-CORRECTNESS-CONTRACT.md).
/data/outcome-approvals/

# Playwright Traces & Screenshots
trace.zip
*.png
*.jpg
*.jpeg
# ...except committed README demo stills (see docs/demo/).
!docs/demo/*.png

# IDE & OS-Specific Files
.vscode/
.DS_Store
Thumbs.db

# Git & CI/CD Artifacts
coverage/
.npm/

# HANDOFF.md is intentionally tracked and ships with the repo.

# Playwright CLI artifacts that can hold credentials or page data
auth.json
*.storage.json
.playwright-cli/
