{
  "model": "sonnet",
  "effortLevel": "medium",
  "permissions": {
    "deny": [
      "Edit(/.git/production-cycle/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ledger-guard.js\""
          }
        ]
      }
    ]
  }
}
